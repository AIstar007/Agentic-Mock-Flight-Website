# Compose variable defaults for the local synthetic POC only.
# Leave optional service URLs blank for `docker compose up --build`.
# Never put company or passenger credentials in this file.
REDIS_URL=
LANGGRAPH_REDIS_URL=
MONGODB_URI=
MONGODB_DATABASE=emirates_checkin_demo
NEO4J_URI=
NEO4J_USERNAME=neo4j
# Local-only demo password; replace before starting the graph profile.
NEO4J_PASSWORD=local-demo-password-change-me

# To enable stateful profile locally, set: 
# REDIS_URL=redis://redis:6379/0
# LANGGRAPH_REDIS_URL=redis://redis:6379/1
# MONGODB_URI=mongodb://mongo:27017/?directConnection=true
# Then run: docker compose --profile stateful up --build
# To enable Neo4j as well, set NEO4J_URI=bolt://neo4j:7687 and run with --profile graph.

# Hosted deployment notes:
# - Use a Redis 8.2+ compatible service with TLS for REDIS_URL.
# - LANGGRAPH_REDIS_URL may be left unset to reuse REDIS_URL.
# - MONGODB_URI must come from your MongoDB Atlas database user.
# - NEO4J_URI is optional; the local JSON rule catalog remains available as fallback.

# Local-only read-only provider diagnostics. Keep disabled unless testing with authorized staging credentials.
# In development, generate a random value for PROVIDER_DIAGNOSTICS_TOKEN and pass it as
# X-Provider-Diagnostics-Token when using /api/v1/provider-tests/*. These routes are hidden in production.
ENABLE_PROVIDER_DIAGNOSTICS=false
PROVIDER_DIAGNOSTICS_TOKEN=
PROVIDER_HTTP_TIMEOUT_SECONDS=15

# Navitaire New Skies read-only BookingRetrieve diagnostic, based on the supplied Bruno request.
# Use the exact base URL and auth values for one approved environment; do not mix hosts/tokens across tenants.
NAVITAIRE_BASE_URL=
NAVITAIRE_BOOKING_RETRIEVE_PATH=/api/v2/graph/BookingRetrieve
NAVITAIRE_BOOKING_STATE_PATH=/api/nsk/v1/booking
NAVITAIRE_CHECKIN_REQUIREMENTS_PATH=/api/nsk/v2/booking/checkin/journey/{journey_key}/requirements
NAVITAIRE_DOCUMENT_CHECK_PATH=/api/nsk/v1/booking/passengers/{passenger_key}/documents/check
# Optional override for the verified provider GraphQL query.
NAVITAIRE_GRAPHQL_QUERY=
NAVITAIRE_API_KEY=
NAVITAIRE_API_KEY_HEADER=
NAVITAIRE_AGENT_TOKEN=
NAVITAIRE_USER_KEY=
NAVITAIRE_AUTH_SCHEME=raw
# Explicit carrier code for the authorised sandbox; set only for the matching approved API tenant.
NAVITAIRE_ALLOWED_CARRIER=

# Timatic staging API. TIMATIC_BASE_URL may be the staging host or full query-interface API base.
TIMATIC_TOKEN_URL=https://staging.timatic.iata.org/security-token-service/oauth2/token
TIMATIC_BASE_URL=https://staging.timatic.iata.org/query-interface-service/api/v1
TIMATIC_USERNAME=
TIMATIC_PASSWORD=
TIMATIC_GRANT_TYPE=client_credentials
TIMATIC_USER_KEY=
# Required only for an approved live provider workflow; confirm the entity with the same authorised tenant/API contract.
TIMATIC_PROCESSING_ENTITY=
# Self-corrective RAG (no LLM credentials required; extracts active approved source text by default).
RAG_MAX_RETRIES=2
RAG_TOP_K=5
# Optional private endpoint added to the supplied Chroma/SQLite reference RAG service.
# Keep blank for the versioned SQLite FAQCorpusStore in this project.
RAG_RETRIEVER_URL=
RAG_RETRIEVER_API_KEY=
# Azure OpenAI (preferred) for Agentic RAG query planning + grounded answer synthesis.
# Endpoint is the Azure OpenAI resource URL, e.g. https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# The deployment NAME shown in Azure AI Foundry (not necessarily the underlying model name).
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Use "v1" for the unified Azure OpenAI API. For older deployments, set a supported dated API version.
AZURE_OPENAI_API_VERSION=v1
# Optional override when the deployment alias does not reveal its model family: true/false/auto.
AZURE_OPENAI_REASONING_MODEL=auto
# Legacy generic OpenAI-compatible endpoint; Azure settings take precedence when fully configured.
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
# Optional general flight-FAQ search via a private SearXNG-compatible JSON endpoint.
# Leave blank to use only the approved versioned FAQ corpus and/or RAG_RETRIEVER_URL.
# Local-only example: http://127.0.0.1:8080/search. Render cannot reach your PC's 127.0.0.1; use a separately hosted HTTPS search endpoint or leave blank.
RAG_WEB_SEARCH_URL=
# Comma-separated HTTPS host allowlist for pages returned by web search (blank uses built-in allowlist).
RAG_WEB_ALLOWED_HOSTS=
# Maximum official pages fetched across planned subqueries in one retrieval batch (0 disables page fetching).
RAG_WEB_FETCH_PAGES=2

# Persistent local Chroma vector store. The active, reviewed SQLite corpus is the source of truth.
CHROMA_PERSIST_DIR=backend/data/chroma_db
CHROMA_COLLECTION=emirates_aviation_knowledge_v1

# Voice I/O via Sarvam AI. Keep the key server-side; never expose it to Vite.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_PACE=1.5
SARVAM_TIMEOUT_SECONDS=45
